rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Аптечки
    match /first_aid_kits/{kitId} {
      allow read: if request.auth != null && 
        (resource.data.users[request.auth.uid] in ['owner', 'editor', 'viewer']);
      allow write: if request.auth != null && 
        (resource.data.users[request.auth.uid] in ['owner', 'editor']);
      allow create: if request.auth != null;
    }
    
    // Лекарства
    match /medicines/{medicineId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && 
        get(/databases/$(database)/documents/first_aid_kits/$(resource.data.firstAidKitId)).data.users[request.auth.uid] in ['owner', 'editor'];
    }
    
    // Пользователи
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
} 